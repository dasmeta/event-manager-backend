# Web Server
HOST=0.0.0.0
PORT=1337
SERVE_ADMIN_PANEL=

# Database
DATABASE_CLIENT=mongo
DATABASE_HOST=
DATABASE_PORT=
DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_URL=

# Database Security
AUTHENTICATION_DATABASE=
DATABASE_SSL=

# JWT settings to validate token
JWT_SECRET=
JWT_ALGORITHM="HS256"
JWT_EXPIRATION=30d

# Centralized Authentication
AUTHENTICATION_SERVICE_API_HOST=
AUTHENTICATION_IS_LIVE_MODE=

# Publish
PUBSUB_EVENTS_DATA_SOURCE=
SANITIZE_KEYS=false

# Stats
# USE_OLD_CALCULATE=true
# Seed empty event-stats rows on startup (background, counts stay 0). On by default.
# SEED_EVENT_STATS_ON_START=false
# Optional extra pairs when event_subscription is empty (JSON array):
# EVENT_STATS_SEED_PAIRS=[{"topic":"my.topic","subscription":"my_sub"}]

# Data retention (optional)
# ENABLE_CRON=true
# DATA_RETENTION_DAYS=40
# DATA_CLEANUP_HOUR=04

# Web Server
HOST=0.0.0.0
PORT=1337
SERVE_ADMIN_PANEL=

# Database
DATABASE_CLIENT=mongo
DATABASE_HOST=
DATABASE_PORT=
DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_URL=

# Database Security
AUTHENTICATION_DATABASE=
DATABASE_SSL=

# JWT settings to validate token
JWT_SECRET=
JWT_ALGORITHM="HS256"
JWT_EXPIRATION=30d

# Centralized Authentication
AUTHENTICATION_SERVICE_API_HOST=
AUTHENTICATION_IS_LIVE_MODE=

# Publish
PUBSUB_EVENTS_DATA_SOURCE=
SANITIZE_KEYS=false

# Stats
# USE_OLD_CALCULATE=true

# Data retention (optional)
# ENABLE_CRON=true
# DATA_RETENTION_DAYS=40
# DATA_CLEANUP_HOUR=04
